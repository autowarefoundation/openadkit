# Complete Compose configuration for CARLA simulation.

# Runtime behavior
ROS_DISTRO=humble
USE_SIM_TIME=true

# Common Autoware settings
POINTCLOUD_CONTAINER_NAME=pointcloud_container
SENSOR_MODEL=carla_sensor_kit
VEHICLE_ID=default
VEHICLE_MODEL=sample_vehicle

# Component images
CARLA_INTERFACE_IMAGE=ghcr.io/autowarefoundation/openadkit:carla-interface-amd64-humble
CARLA_INTERFACE_CONTAINER=autoware-carla-interface
CARLA_MAP_LOADER_CONTAINER=carla-map-loader
CARLA_PYTHON_VERSION=0.9.16
SENSING_PERCEPTION_IMAGE=ghcr.io/autowarefoundation/openadkit:sensing-perception-cuda

# CARLA runtime (headless off-screen, official 0.9.16 path).
CARLA_CONTAINER_IMAGE=carlasim/carla:0.9.16@sha256:aaf1df22702780ece072069e23d03c4879b002ae028c79744b09c4c7ddbae953
CARLA_CONTAINER_NAME=carla-e2e
CARLA_RENDER_ARGS=-RenderOffScreen
CARLA_RPC_HOST=127.0.0.1
CARLA_RPC_PORT=2000
CARLA_WORLD_PORT=2000
CARLA_WORLD=Town01
CARLA_QUALITY=Low
CARLA_LOAD_TIMEOUT=180

# Official CARLA Autoware map assets
CARLA_E2E_POINTCLOUD_URL=https://bitbucket.org/carla-simulator/autoware-contents/raw/062f94b5322e679ee0430e2daa6995dca9f7f0ea/maps/point_cloud_maps/Town01.pcd
CARLA_E2E_POINTCLOUD_SHA256=296d6429ae0190b19a35458a155d76d8e3c4f460eb718cde3d669bc5a8f03ba2
CARLA_E2E_LANELET2_URL=https://bitbucket.org/carla-simulator/autoware-contents/raw/062f94b5322e679ee0430e2daa6995dca9f7f0ea/maps/vector_maps/lanelet2/Town01.osm
CARLA_E2E_LANELET2_SHA256=5e3c0873004666a399494a59048b93ecfbd1d40433c29d29e7319847a2a8afa2

# Map and artifacts
MAP_PATH=$HOME/autoware_data/maps/Town01
POINTCLOUD_MAP_FILE=pointcloud_map.pcd
LANELET2_MAP_FILE=lanelet2_map.osm
DATA_PATH=$HOME/autoware_data

# Planning and control
SCENARIO_SIMULATION=false
ENABLE_ALL_MODULES_AUTO_MODE=true
IS_SIMULATION_MODE=true
PLANNING_MODULE_PRESET=default
CHECK_EXTERNAL_EMERGENCY_HEARTBEAT=false
CONTROL_MODULE_PRESET=default
LATERAL_CONTROLLER_MODE=mpc
LONGITUDINAL_CONTROLLER_MODE=pid

# Vehicle and system
LAUNCH_VEHICLE_INTERFACE=false
SYSTEM_RUN_MODE=online
LAUNCH_SYSTEM_MONITOR=false
LAUNCH_DUMMY_DIAG_PUBLISHER=false

# Sensing and perception
LAUNCH_POINTCLOUD_CONTAINER_SENSING=true
LAUNCH_SENSING_DRIVER=false
LAUNCH_POINTCLOUD_CONTAINER_PERCEPTION=false
LIDAR_DETECTION_MODEL=clustering
OCCUPANCY_GRID_MAP_METHOD=pointcloud_based
PERCEPTION_MODE=lidar

# Disabled base simulator still requires interpolation values
INITIAL_ENGAGE_STATE=false
LAUNCH_DUMMY_DOORS=false
LAUNCH_DUMMY_PERCEPTION=false
LAUNCH_DUMMY_VEHICLE=false
LAUNCH_SCENARIO_SIMULATOR_V2_ADAPTER=false
LOCALIZATION_SIM_MODE=none
PERCEPTION_ENABLE_DETECTION_FAILURE=false
PERCEPTION_ENABLE_OBJECT_RECOGNITION=true
PERCEPTION_ENABLE_TRAFFIC_LIGHT=false
PERCEPTION_USE_BASE_LINK_Z=false
SENSING_VISIBLE_RANGE=300.0
USE_POINTCLOUD_CONTAINER=false

# E2E launch and verification
AUTOWARE_E2E_EMPTY_OBJECTS=false
AUTOWARE_E2E_USE_TRAFFIC_LIGHT_RECOGNITION=false
AUTOWARE_E2E_START_VISUALIZER=true
AUTOWARE_E2E_VERIFY_TIMEOUT=180
AUTOWARE_E2E_VERIFY_INTERVAL=5
AUTOWARE_E2E_AUTO_DRIVE=false
AUTOWARE_E2E_ROUTE_FORWARD_DISTANCE=55.0
AUTOWARE_E2E_ROUTE_SETTLE_TIMEOUT=90
AUTOWARE_E2E_DRIVE_VERIFY_TIMEOUT=90
AUTOWARE_E2E_DRIVE_VERIFY_DISTANCE=3.0

# Visualization
REMOTE_DISPLAY=true
RVIZ_CONFIG=/opt/autoware/autoware_launch/share/autoware_launch/rviz/autoware.rviz
REMOTE_PASSWORD=openadkit
