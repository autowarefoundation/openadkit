{
  "schemaVersion": 2,
  "name": "carla-simulation",
  "description": "Run Autoware closed-loop against CARLA 0.9.16",
  "evidence": {"exempt": "Needs an NVIDIA GPU with 16 GB of VRAM; the CI runners have no GPU."},
  "shared": ["shared"],
  "compose": {
    "files": ["docker-compose.yaml"],
    "gpuFiles": [],
    "profiles": [],
    "resetServices": ["map-check", "carla-map-loader"],
    "waitTimeout": 480
  },
  "nodes": {
    "autoware": {
      "backend": "compose",
      "rosDomainId": 1,
      "files": ["compose.autoware.yaml"],
      "requiredFiles": ["config/zenoh.json5"],
      "resetServices": ["map-check"],
      "requiredEnv": ["ZENOH_LISTEN"]
    },
    "carla": {
      "backend": "compose",
      "rosDomainId": 2,
      "files": ["compose.carla.yaml"],
      "requiredFiles": ["config/zenoh.json5"],
      "resetServices": ["carla-map-loader"],
      "requiredEnv": ["ZENOH_LISTEN", "ZENOH_PEER"]
    }
  },
  "requirements": {
    "architectures": ["amd64"],
    "rosDistros": ["humble"],
    "gpu": "required"
  },
  "data": [
    {
      "name": "town01-map",
      "kind": "files",
      "destinationEnv": "MAP_PATH",
      "files": [
        {
          "path": "lanelet2_map.osm",
          "source": "data/lanelet2_map.osm",
          "sha256": "5fe0f15b9c40b12eea973bf2e67209b622a1003ecf5327c353b64b1c94c9bf6a"
        },
        {
          "path": "pointcloud_map.pcd",
          "url": "https://bitbucket.org/carla-simulator/autoware-contents/raw/062f94b5322e679ee0430e2daa6995dca9f7f0ea/maps/point_cloud_maps/Town01.pcd",
          "sha256": "296d6429ae0190b19a35458a155d76d8e3c4f460eb718cde3d669bc5a8f03ba2"
        }
      ],
      "generatedFiles": {
        "map_projector_info.yaml": "projector_type: Local\n"
      },
      "requiredFiles": [
        "lanelet2_map.osm",
        "pointcloud_map.pcd",
        "map_projector_info.yaml"
      ],
      "nodes": ["autoware"]
    }
  ]
}
