# Complete Compose configuration for planning simulation.

# Runtime behavior
USE_SIM_TIME=false

# Common Autoware settings
POINTCLOUD_CONTAINER_NAME=pointcloud_container
SENSOR_MODEL=sample_sensor_kit
VEHICLE_ID=default
VEHICLE_MODEL=sample_vehicle

# Map
MAP_PATH=$HOME/autoware_map/sample-map-planning
POINTCLOUD_MAP_FILE=pointcloud_map.pcd
LANELET2_MAP_FILE=lanelet2_map.osm

# Planning and control
SCENARIO_SIMULATION=false
ENABLE_ALL_MODULES_AUTO_MODE=false
IS_SIMULATION_MODE=true
PLANNING_MODULE_PRESET=default
CHECK_EXTERNAL_EMERGENCY_HEARTBEAT=false
CONTROL_MODULE_PRESET=default
LATERAL_CONTROLLER_MODE=mpc
LONGITUDINAL_CONTROLLER_MODE=pid

# Vehicle and system
LAUNCH_VEHICLE_INTERFACE=true
SYSTEM_RUN_MODE=planning_simulation
LAUNCH_SYSTEM_MONITOR=false
LAUNCH_DUMMY_DIAG_PUBLISHER=true

# Simulator and perception
INITIAL_ENGAGE_STATE=true
LAUNCH_DUMMY_DOORS=true
LAUNCH_FAULT_INJECTION=false
# Laserscan-based occupancy grid map of the perception simulation.
LAUNCH_OCCUPANCY_GRID_MAP=true
LAUNCH_DUMMY_PERCEPTION=true
LAUNCH_DUMMY_VEHICLE=true
LAUNCH_SCENARIO_SIMULATOR_V2_ADAPTER=false
LOCALIZATION_SIM_MODE=api
PERCEPTION_ENABLE_DETECTION_FAILURE=true
PERCEPTION_ENABLE_OBJECT_RECOGNITION=true
PERCEPTION_USE_BASE_LINK_Z=true
SENSING_VISIBLE_RANGE=300.0
USE_POINTCLOUD_CONTAINER=false

# Visualization
REMOTE_DISPLAY=true
RVIZ_CONFIG=/tmp/openadkit/autoware_launch/share/autoware_launch/rviz/autoware.rviz
REMOTE_PASSWORD=openadkit

# Readiness, which `openadkit run` waits for: the AD API is up and autonomous-mode
# availability is published (deployments/shared/checks/readiness.py).
READINESS_CHECKS=--service /api/localization/initialize --service /api/routing/set_route_points --service /api/operation_mode/change_to_autonomous --topic /api/routing/state --topic /api/localization/initialization_state --topic /api/operation_mode/state --fresh /system/operation_mode/availability
