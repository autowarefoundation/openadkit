# Same stack as carla-simulation, with sensors-only carla-interface overlay.
# Keep values in sync with ../carla-simulation/config.env.

# Runtime behavior
ROS_DISTRO=humble
USE_SIM_TIME=true

# Common Autoware settings
POINTCLOUD_CONTAINER_NAME=pointcloud_container
SENSOR_MODEL=carla_sensor_kit
VEHICLE_ID=default
VEHICLE_MODEL=sample_vehicle

# Component images
CARLA_INTERFACE_IMAGE=ghcr.io/autowarefoundation/openadkit:carla-interface-amd64-humble@sha256:aed3f8d7da178e2c4a78a03bebfb2dc9a30623de07670f66626d765c3158e849
SENSING_PERCEPTION_GPU_IMAGE=ghcr.io/autowarefoundation/openadkit:sensing-perception-cuda@sha256:e8f71853146aa655524f82c08b2d27a555eb83b83e6cd828299383f054dec74c
LOCALIZATION_MAPPING_IMAGE=ghcr.io/autowarefoundation/openadkit:localization-mapping@sha256:e891d8ac9408a11fb21a368a03b7739244ddcea4aceb3cf94e40cb37ed3871ce
PLANNING_CONTROL_IMAGE=ghcr.io/autowarefoundation/openadkit:planning-control@sha256:b41465d44d7d5f2eab30fe57bf2dab11c07cc649dcb56b1f2baf6dd48713b5d8
VEHICLE_SYSTEM_IMAGE=ghcr.io/autowarefoundation/openadkit:vehicle-system@sha256:2959fd95c888c0b05159b28496538cb55d3fb4c506cd016818721e1fbfc0712b
API_IMAGE=ghcr.io/autowarefoundation/openadkit:api@sha256:0f91340b46f39499e3a4fe1e78b48c2410492c1c2af3188b4f01800159dfc4f3
VISUALIZER_IMAGE=ghcr.io/autowarefoundation/openadkit:visualizer@sha256:3903e3f2f12c7fb81f90fe7a51874479dad470d479430d8e4ade495215626c65
CARLA_INTERFACE_CONTAINER=autoware-carla-interface
CARLA_MAP_LOADER_CONTAINER=carla-map-loader
CARLA_PYTHON_VERSION=0.9.16

# CARLA runtime (headless off-screen, official 0.9.16 path).
CARLA_CONTAINER_IMAGE=carlasim/carla:0.9.16@sha256:aaf1df22702780ece072069e23d03c4879b002ae028c79744b09c4c7ddbae953
CARLA_CONTAINER_NAME=carla-e2e
CARLA_RENDER_ARGS=-RenderOffScreen
CARLA_RPC_HOST=127.0.0.1
CARLA_RPC_PORT=2000
CARLA_WORLD_PORT=2000
CARLA_WORLD=Town01
CARLA_QUALITY=Low
CARLA_LOAD_TIMEOUT=180

# Map and artifacts
MAP_PATH=$HOME/autoware_data/maps/Town01
POINTCLOUD_MAP_FILE=pointcloud_map.pcd
LANELET2_MAP_FILE=lanelet2_map.osm
DATA_PATH=$HOME/autoware_data

# Planning and control
SCENARIO_SIMULATION=false
ENABLE_ALL_MODULES_AUTO_MODE=true
IS_SIMULATION_MODE=true
PLANNING_MODULE_PRESET=default
CHECK_EXTERNAL_EMERGENCY_HEARTBEAT=false
CONTROL_MODULE_PRESET=default
LATERAL_CONTROLLER_MODE=mpc
LONGITUDINAL_CONTROLLER_MODE=pid

# Vehicle and system
LAUNCH_VEHICLE_INTERFACE=false
SYSTEM_RUN_MODE=online
LAUNCH_SYSTEM_MONITOR=false
LAUNCH_DUMMY_DIAG_PUBLISHER=false

# Sensing and perception
LAUNCH_POINTCLOUD_CONTAINER_SENSING=true
LAUNCH_SENSING_DRIVER=false
LAUNCH_POINTCLOUD_CONTAINER_PERCEPTION=false
LIDAR_DETECTION_MODEL=clustering
OCCUPANCY_GRID_MAP_METHOD=pointcloud_based
PERCEPTION_MODE=lidar

# Perception launch flags
AUTOWARE_E2E_EMPTY_OBJECTS=false
AUTOWARE_E2E_USE_TRAFFIC_LIGHT_RECOGNITION=false

# Visualization
REMOTE_DISPLAY=true
RVIZ_CONFIG=/opt/autoware/autoware_launch/share/autoware_launch/rviz/autoware.rviz
REMOTE_PASSWORD=openadkit
