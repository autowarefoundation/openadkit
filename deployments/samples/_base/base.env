# Open AD Kit deployment base env.
#
# Defaults shared by every sample (identical value across planning/scenario/
# logging). Each sample's own <sample>.env carries only its deltas. At release
# time these two files are concatenated into a single <sample>.env so the shipped
# bundle is run with one `--env-file`. From a cloned repo, pass both:
#   docker compose --env-file ../_base/base.env --env-file <sample>.env up -d

# ROS settings
ROS_DOMAIN_ID=1

# Common settings
POINTCLOUD_CONTAINER_NAME=pointcloud_container
SENSOR_MODEL=sample_sensor_kit
VEHICLE_ID=default
VEHICLE_MODEL=sample_vehicle

# Map settings
POINTCLOUD_MAP_FILE=pointcloud_map.pcd
LANELET2_MAP_FILE=lanelet2_map.osm

# Planning settings
SCENARIO_SIMULATION=false
ENABLE_ALL_MODULES_AUTO_MODE=false
IS_SIMULATION_MODE=true
PLANNING_MODULE_PRESET=default

# Control settings
CHECK_EXTERNAL_EMERGENCY_HEARTBEAT=false
CONTROL_MODULE_PRESET=default
LATERAL_CONTROLLER_MODE=mpc
LONGITUDINAL_CONTROLLER_MODE=pid

# System settings
LAUNCH_SYSTEM_MONITOR=false

# Perception / sensing settings
PERCEPTION_ENABLE_OBJECT_RECOGNITION=true
SENSING_VISIBLE_RANGE=300.0

# Visualization settings
REMOTE_DISPLAY=true
# REMOTE_PASSWORD is the noVNC/VNC password. The visualizer entrypoint exits 1
# on an empty value, so this MUST be set for any sample that starts a
# visualizer. The default below is intentionally weak and is only safe to
# ship because the visualizer's websockify is bound to loopback (see
# components/visualizer/etc/visualizer_entrypoint.sh). Replace it before
# exposing the visualizer on any non-loopback interface.
REMOTE_PASSWORD=openadkit
