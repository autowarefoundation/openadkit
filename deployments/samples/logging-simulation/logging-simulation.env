# ROS settings
USE_SIM_TIME=true

# Common settings
SCENARIO_SIMULATION=false

# Map settings
LANELET2_MAP_FILE=lanelet2_map.osm
MAP_PATH=$HOME/autoware_map/sample-map-rosbag

# Planning settings

# Control settings

# Vehicle interface
LAUNCH_VEHICLE_INTERFACE=false

# System settings
SYSTEM_RUN_MODE=logging_simulation
LAUNCH_DUMMY_DIAG_PUBLISHER=false

# Sensing settings
LAUNCH_POINTCLOUD_CONTAINER_SENSING=true
LAUNCH_SENSING_DRIVER=false

# Perception settings
DATA_PATH=$HOME/autoware_data
LAUNCH_POINTCLOUD_CONTAINER_PERCEPTION=false
LIDAR_DETECTION_MODEL=clustering
OCCUPANCY_GRID_MAP_METHOD=laserscan_based
PERCEPTION_MODE=lidar

# Simulator settings
INITIAL_ENGAGE_STATE=false
LAUNCH_DUMMY_DOORS=false
LAUNCH_DUMMY_PERCEPTION=false
LAUNCH_DUMMY_VEHICLE=false
LAUNCH_SCENARIO_SIMULATOR_V2_ADAPTER=false
LOCALIZATION_SIM_MODE=none
PERCEPTION_ENABLE_DETECTION_FAILURE=false
PERCEPTION_ENABLE_TRAFFIC_LIGHT=true
PERCEPTION_USE_BASE_LINK_Z=false
USE_POINTCLOUD_CONTAINER=true

# Visualization settings
# Default noVNC password for LOCAL use only. The visualizer port is bound to
# 127.0.0.1 in docker-compose.yaml, so this default is not network-exposed.
# Change it (and the port binding) before exposing the visualizer remotely.
RVIZ_CONFIG=/opt/autoware/share/autoware_launch/rviz/autoware.rviz

# Rosbag settings
ROSBAG_PATH=$HOME/autoware_map/sample-rosbag
ROSBAG_RATE=0.4
ROSBAG_FORMAT=sqlite3
