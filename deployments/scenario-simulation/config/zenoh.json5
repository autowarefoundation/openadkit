// Zenoh bridge allowlist for split-host scenario-simulation.
//
// Applied by both node graphs (--node autoware and --node scenario): either
// host can own an endpoint, so publishers/subscribers and service
// servers/clients list the same routes. Entries are full-name regular
// expressions, not globs. When `allow` is set, an omitted/empty type list
// means none.
//
// Derived from the pinned Scenario Simulator V2 25.0.20 concealer interfaces
// (AutowareUniverse, FieldOperatorApplication) plus the Autoware ADAPI
// servers/clients. The simple sensor simulator's detection, obstacle
// segmentation, occupancy grid, and IMU outputs are included because the
// Autoware host consumes/visualizes them and the single-host graph kept them
// local; autonomous emergency braking needs the IMU, and autonomous-mode
// availability on the Autoware host depends on that control stack coming up.
// Map blobs, camera images, and visualization/teleop
// interfaces are intentionally excluded.
//
// The visualizer runs on the scenario host, so the topics its RViz config
// shows come across too (the Autoware ADAPI, which its panels use, as /api/.*).
// Zenoh sends a topic across only when the other host subscribes to it, so
// without a visualizer they do not cross the LAN.
{
  plugins: {
    ros2dds: {
      allow: {
        publishers: [
          "/clock",
          "/tf",
          "/tf_static",
          "/simulation/.*",
          "/vehicle/status/.*",
          "/control/command/.*",
          "/perception/obstacle_segmentation/pointcloud",
          "/perception/object_recognition/detection/objects",
          "/perception/occupancy_grid_map/map",
          "/sensing/imu/imu_data",
          "/localization/acceleration",
          "/localization/kinematic_state",
          "/planning/scenario_planning/lane_driving/behavior_planning/path_with_lane_id",
          "/autoware/state",
          "/api/.*",
          // RViz on this host, which split-host runs here rather than on the edge.
          "/robot_description",
          "/map/vector_map_marker",
          "/planning/trajectory",
          "/planning/scenario_planning/lane_driving/behavior_planning/path",
          "/planning/scenario_planning/modified_goal",
          "/planning/path_candidate/.*",
          "/planning/mission_planning/(goal|echo_back_goal_pose|route_marker)",
          "/(planning|control)/.*/virtual_walls?(/.*)?",
          "/perception/object_recognition/objects",
        ],
        subscribers: [
          "/clock",
          "/tf",
          "/tf_static",
          "/simulation/.*",
          "/vehicle/status/.*",
          "/control/command/.*",
          "/perception/obstacle_segmentation/pointcloud",
          "/perception/object_recognition/detection/objects",
          "/perception/occupancy_grid_map/map",
          "/sensing/imu/imu_data",
          "/localization/acceleration",
          "/localization/kinematic_state",
          "/planning/scenario_planning/lane_driving/behavior_planning/path_with_lane_id",
          "/autoware/state",
          "/api/.*",
          // RViz on this host, which split-host runs here rather than on the edge.
          "/robot_description",
          "/map/vector_map_marker",
          "/planning/trajectory",
          "/planning/scenario_planning/lane_driving/behavior_planning/path",
          "/planning/scenario_planning/modified_goal",
          "/planning/path_candidate/.*",
          "/planning/mission_planning/(goal|echo_back_goal_pose|route_marker)",
          "/(planning|control)/.*/virtual_walls?(/.*)?",
          "/perception/object_recognition/objects",
        ],
        service_servers: [
          "/control/control_mode_request",
          "/simulation/.*",
          "/api/.*",
        ],
        service_clients: [
          "/control/control_mode_request",
          "/simulation/.*",
          "/api/.*",
        ],
        action_servers: [],
        action_clients: [],
      },

      // Callers allow 10 s for routing and a configurable (default 90 s)
      // localization initialization; keep bridge-side query timeouts at or
      // above those budgets.
      queries_timeout: {
        services: [
          "/api/localization/initialize=120.0",
          "/api/routing/set_route=30.0",
          "/api/routing/set_route_points=30.0",
          ".*=10.0",
        ],
      },
    },
  },
}
