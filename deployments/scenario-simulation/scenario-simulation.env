# ROS settings
USE_SIM_TIME=true

# Common settings
SCENARIO_SIMULATION=true

# Map settings
MAP_PATH=$HOME/autoware_map/kashiwanoha_map

# Vehicle interface
LAUNCH_VEHICLE_INTERFACE=true

# System settings
SYSTEM_RUN_MODE=planning_simulation
LAUNCH_DUMMY_DIAG_PUBLISHER=true

# Simulator settings
INITIAL_ENGAGE_STATE=true
LAUNCH_DUMMY_DOORS=true
LAUNCH_DUMMY_PERCEPTION=false
LAUNCH_DUMMY_VEHICLE=false
LAUNCH_SCENARIO_SIMULATOR_V2_ADAPTER=true
LOCALIZATION_SIM_MODE=api
PERCEPTION_ENABLE_DETECTION_FAILURE=true
PERCEPTION_ENABLE_TRAFFIC_LIGHT=false
PERCEPTION_USE_BASE_LINK_Z=true
USE_POINTCLOUD_CONTAINER=false

# Scenario simulator settings
SCENARIO_SIMULATOR_IMAGE=ghcr.io/tier4/scenario_simulator_v2:humble-25.0.20-runtime
LAUNCH_AUTOWARE=false
LAUNCH_RVIZ=false
LAUNCH_VISUALIZATION=false
USE_CUSTOM_CENTERLINE=true
ARCHITECTURE_TYPE=awf/universe/20250130
# Leave empty to use scenario_test_runner's bundled sample scenario.
# For custom scenarios, mount files under SCENARIO_HOST_DIR and set SCENARIO=/scenarios/<file>.yaml.
SCENARIO=
INITIALIZE_DURATION=90
SCENARIO_READY_TIMEOUT=300
GLOBAL_FRAME_RATE=30
GLOBAL_TIMEOUT=180
SCENARIO_SIMULATOR_PORT=5556
OUTPUT_DIRECTORY=/autoware/scenario-sim/output
OUTPUT_HOST_PATH=./output
SCENARIO_HOST_DIR=./scenarios
RECORD=false

# Visualization settings
# Default noVNC password for LOCAL use only. The visualizer port is bound to
# 127.0.0.1 in docker-compose.yaml, so this default is not network-exposed.
# Change it (and the port binding) before exposing the visualizer remotely.
RVIZ_CONFIG=/opt/autoware/autoware_launch/share/autoware_launch/rviz/scenario_simulator.rviz
