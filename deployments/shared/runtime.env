# Container runtime env for Autoware services (service env_file:).
# Compose config lives in each deployment's complete config.env.
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ROS_DOMAIN_ID=1
CYCLONEDDS_URI=file:///etc/cyclonedds/cyclonedds.xml
# Single-host default. Set an exact LAN/VPN interface to opt in to cross-host DDS.
CYCLONEDDS_NETWORK_INTERFACE=lo
