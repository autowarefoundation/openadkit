# Container runtime env for Autoware services (service env_file:).
# Compose config lives in each deployment's complete settings.env.
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# Split-host roles each get their own domain from the manifest (rosDomainId).
ROS_DOMAIN_ID=${OPENADKIT_ROS_DOMAIN_ID:-1}
CYCLONEDDS_URI=file:///etc/cyclonedds/cyclonedds.xml
# Single-host default. Set an exact LAN/VPN interface in the host settings file
# to opt in to cross-host DDS; split-host roles always use lo (the CLI sets it).
CYCLONEDDS_NETWORK_INTERFACE=${CYCLONEDDS_NETWORK_INTERFACE:-lo}
# The image entrypoint links this vehicle's description to a stable path.
VEHICLE_MODEL=${VEHICLE_MODEL:-}
# The image entrypoint moves the aw user to these ids, so files written to host
# mounts belong to the host user. The CLI sets them; empty leaves aw at 1000.
HOST_UID=${OPENADKIT_UID:-}
HOST_GID=${OPENADKIT_GID:-}
