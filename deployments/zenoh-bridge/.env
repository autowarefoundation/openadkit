# Map mounted from the host (fetch it first: ./fetch-sample-data.sh zenoh-bridge)
MAP_PATH=$HOME/autoware_map/kashiwanoha_map

# ROS distribution used by the monolithic Autoware container in this demo.
ROS_DISTRO=humble

# REQUIRED: Password for the noVNC visualizer (port 6080/6081).
# There is no default — the visualizer refuses to start until this is set.
REMOTE_PASSWORD=

# Host interface for the cloud Zenoh router. Keep loopback for single-host demos.
# Set to 0.0.0.0 only when a remote edge host must connect to this machine.
ZENOH_ROUTER_BIND_IP=127.0.0.1
