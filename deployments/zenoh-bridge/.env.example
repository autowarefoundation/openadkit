# Copy this file to .env. Docker Compose reads .env without executing it, and
# variables exported by the calling shell take precedence over these values.

# Map mounted from the host (fetch it first: ./install.sh sample-data zenoh-bridge)
MAP_PATH=$HOME/autoware_map/kashiwanoha_map

# ROS distribution used by the monolithic Autoware container in this demo.
ROS_DISTRO=humble

# REQUIRED: Password for the noVNC visualizer (port 6080/6081).
REMOTE_PASSWORD=
