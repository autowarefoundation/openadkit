# Copy this file to .env. Docker Compose reads .env without executing it, and
# variables exported by the calling shell take precedence over these values.

# Map mounted from the host (fetch it first: ./install.sh sample-data zenoh-bridge)
MAP_PATH=$HOME/autoware_map/kashiwanoha_map

# ROS distribution used by the monolithic Autoware container in this demo.
ROS_DISTRO=humble

# REQUIRED: Password for the noVNC visualizer only (port 6080/6081).
# This password does not authenticate or encrypt the Zenoh transport.
REMOTE_PASSWORD=

# Host interface for the cloud Zenoh router. Keep loopback for single-host demos.
# For remote use, set an exact VPN/private-interface address. Do not use 0.0.0.0;
# the Zenoh endpoint has no transport authentication or encryption.
ZENOH_ROUTER_BIND_IP=127.0.0.1
