# Complete Docker Compose interpolation values for this deployment. Variables
# exported by the calling shell take precedence over these values.

# Map mounted from the host (fetch it first: ./openadkit fetch scenario-simulation)
MAP_PATH=$HOME/autoware_map/kashiwanoha_map

# ROS distribution used by the monolithic Autoware container in this demo.
ROS_DISTRO=humble

# Password for the noVNC visualizer (port 6080/6081).
REMOTE_PASSWORD=openadkit
