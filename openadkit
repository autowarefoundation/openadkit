#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)

if [[ ${1:-} == setup ]]; then
  exec bash "$SCRIPT_DIR/cli/setup.sh" "$@"
fi

if ! command -v python3 >/dev/null 2>&1; then
  printf 'python3 is required. Run: ./openadkit setup\n' >&2
  exit 1
fi

export OPENADKIT_ROOT="$SCRIPT_DIR"
exec python3 "$SCRIPT_DIR/cli/main.py" "$@"
