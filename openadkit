#!/usr/bin/env bash
set -euo pipefail

readonly OPENADKIT_REPOSITORY=${OPENADKIT_REPOSITORY:-autowarefoundation/openadkit}
readonly OPENADKIT_RELEASES_URL=${OPENADKIT_RELEASES_URL:-"https://github.com/${OPENADKIT_REPOSITORY}/releases"}
# Strict SemVer release tag. The same pattern appears in cli/installation.py,
# .github/scripts/release_plan.py and validate_release.sh; the bootstrap
# cannot import it, so test_release_versions.py checks all four agree.
readonly OPENADKIT_VERSION_RE='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(\.((0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?$'

INSTALL_TEMP=
INSTALL_STAGE=
# A replaced release moved aside, and where it goes back if the swap stops.
INSTALL_ASIDE=
INSTALL_FINAL=
RESOLVED_VERSION=
RESOLVED_ARCHIVE=
RESOLVED_SHA256=

fail() { printf 'error: %s\n' "$*" >&2; exit 1; }
usage_fail() { printf 'error: %s\n' "$*" >&2; exit 2; }
log() { printf '[openadkit] %s\n' "$*"; }

cleanup_install() {
  if [[ -n $INSTALL_ASIDE && ! -e $INSTALL_FINAL ]]; then
    mv -T "$INSTALL_ASIDE" "$INSTALL_FINAL"
  fi
  [[ -z $INSTALL_TEMP ]] || rm -rf "$INSTALL_TEMP"
  [[ -z $INSTALL_STAGE ]] || rm -rf "$INSTALL_STAGE"
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "$1 is required"
}

install_usage() {
  cat <<'EOF'
Usage: openadkit install [--version vX.Y.Z] [--destination DIRECTORY] [--force]

Downloads and verifies an Open AD Kit release bundle. The default destination is
$OPENADKIT_INSTALL_DIR, else ~/.local/share/openadkit. A launcher is installed at
~/.local/bin/openadkit, with adkit as its short name and Tab completion for both.
Reinstalling over an existing version requires --force.

To move an installed release to the latest stable version, run: openadkit upgrade
EOF
}

# Links the installer made point into a versioned release directory; any
# other file at a link's path is the user's and is left alone.
link_beside_launcher() {
  local target=$1 path=$2
  if [[ -e $path || -L $path ]] && [[ ! -L $path || $(readlink "$path") != */openadkit-v*/* ]]; then
    log "kept ${path}: it was not installed by openadkit"
    return 0
  fi
  ln -sfn "$target" "${path}.new"
  mv -Tf "${path}.new" "$path"
}

start_install_temp() {
  INSTALL_TEMP=$(mktemp -d "${TMPDIR:-/tmp}/openadkit-install.XXXXXXXX")
  trap cleanup_install EXIT
  trap 'exit 130' INT TERM
}

release_base_url() {
  if [[ $1 == latest ]]; then
    printf '%s/latest/download\n' "${OPENADKIT_RELEASES_URL}"
  else
    printf '%s/download/%s\n' "${OPENADKIT_RELEASES_URL}" "$1"
  fi
}

download_release_metadata() {
  local requested=$1 metadata release_fields
  metadata="${INSTALL_TEMP}/release-metadata.json"
  log "downloading release metadata"
  curl --proto '=https' --tlsv1.2 -fsSL --retry 3 --retry-delay 1 \
    "$(release_base_url "$requested")/release-metadata.json" -o "${metadata}"

  readarray -t release_fields < <(python3 - "${metadata}" "${OPENADKIT_VERSION_RE}" <<'PY'
import json
import re
import sys

try:
    metadata = json.load(open(sys.argv[1], encoding="utf-8"))
    version = metadata["openadkit_version"]
    bundles = metadata["bundles"]
    if not isinstance(version, str) or not re.fullmatch(sys.argv[2], version):
        raise ValueError("invalid Open AD Kit version")
    if not isinstance(bundles, list) or len(bundles) != 1:
        raise ValueError("expected exactly one release bundle")
    bundle = bundles[0]
    name, digest = bundle["name"], bundle["sha256"]
    if name != f"openadkit-{version}.tar.gz":
        raise ValueError("bundle name does not match the release version")
    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
        raise ValueError("invalid bundle SHA-256")
    print(version, name, digest, sep="\t")
except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as error:
    print(f"invalid release metadata: {error}", file=sys.stderr)
    raise SystemExit(1)
PY
)
  ((${#release_fields[@]} == 1)) || exit 1
  IFS=$'\t' read -r RESOLVED_VERSION RESOLVED_ARCHIVE RESOLVED_SHA256 <<<"${release_fields[0]}"
}

install_resolved_release() {
  local release_version=$1 archive_name=$2 expected_sha256=$3
  local destination=$4 force=$5 announce_next=$6
  local root_name final_root staged_bundle launcher_dir launcher_path link_path moved_aside
  local next_command completion_dir name

  root_name="openadkit-${release_version}"
  final_root="${destination}/${root_name}"
  if [[ -e $final_root && $force != true ]]; then
    fail "${final_root} already exists; rerun with --force to replace it"
  fi
  launcher_dir="${HOME}/.local/bin"
  launcher_path="${launcher_dir}/openadkit"
  if [[ -e $launcher_path && ! -L $launcher_path ]]; then
    fail "refusing to replace non-symlink launcher: ${launcher_path}"
  fi

  staged_bundle="${INSTALL_TEMP}/${archive_name}"
  log "downloading ${release_version}"
  curl --proto '=https' --tlsv1.2 -fsSL --retry 3 --retry-delay 1 \
    "$(release_base_url "$release_version")/${archive_name}" -o "${staged_bundle}"
  printf '%s  %s\n' "$expected_sha256" "$staged_bundle" | sha256sum --check --status \
    || fail "checksum verification failed for ${archive_name}"

  python3 - "${staged_bundle}" "${root_name}" <<'PY'
import tarfile
import sys

archive, root = sys.argv[1:]

def member_is_safe(name):
    if name.startswith("/") or name.startswith("\\"):
        return False
    parts = [
        part
        for part in name.replace("\\", "/").split("/")
        if part not in ("", ".")
    ]
    return bool(parts) and ".." not in parts and parts[0] == root

try:
    with tarfile.open(archive, "r:gz") as bundle:
        members = bundle.getmembers()
        if not members:
            raise ValueError("bundle is empty")
        for member in members:
            if not member_is_safe(member.name):
                raise ValueError(f"unsafe bundle member: {member.name}")
            if member.issym() or member.islnk() or member.isdev():
                raise ValueError(f"unsupported bundle member: {member.name}")
except (OSError, tarfile.TarError, ValueError) as error:
    print(f"invalid release bundle: {error}", file=sys.stderr)
    raise SystemExit(1)
PY

  mkdir -p "$destination"
  INSTALL_STAGE=$(mktemp -d "${destination}/.openadkit-stage.XXXXXXXX")
  tar -xzf "$staged_bundle" -C "$INSTALL_STAGE" --no-same-owner --no-same-permissions
  [[ -x "${INSTALL_STAGE}/${root_name}/openadkit" ]] \
    || fail 'release bundle is missing its executable entry point'

  # Re-check immediately before the swap so a concurrent install cannot be
  # silently replaced unless --force was requested.
  if [[ -e $final_root && $force != true ]]; then
    fail "${final_root} already exists; rerun with --force to replace it"
  fi
  moved_aside=
  if [[ -e $final_root ]]; then
    moved_aside="${destination}/.openadkit-old.$$"
    while [[ -e $moved_aside ]]; do
      moved_aside="${moved_aside}-x"
    done
    INSTALL_ASIDE=$moved_aside INSTALL_FINAL=$final_root
    mv -T "$final_root" "$moved_aside"
  fi
  # On failure or interruption, cleanup_install moves the old release back.
  mv "${INSTALL_STAGE}/${root_name}" "$final_root" || fail "could not replace ${final_root}"
  INSTALL_ASIDE=
  if [[ -n $moved_aside ]]; then
    rm -rf "$moved_aside"
  fi
  rmdir "$INSTALL_STAGE"
  INSTALL_STAGE=

  mkdir -p "$launcher_dir"
  link_path="${launcher_path}.new"
  ln -sfn "$final_root/openadkit" "$link_path"
  mv -Tf "$link_path" "$launcher_path"
  # adkit, the short name, and Tab completion for both, which bash-completion
  # loads from this directory on first use.
  link_beside_launcher "$final_root/openadkit" "${launcher_dir}/adkit"
  if [[ -f "$final_root/cli/completion.bash" ]]; then
    completion_dir="${XDG_DATA_HOME:-${HOME}/.local/share}/bash-completion/completions"
    mkdir -p "$completion_dir"
    for name in openadkit adkit; do
      link_beside_launcher "$final_root/cli/completion.bash" "${completion_dir}/${name}"
    done
  fi

  cleanup_install
  INSTALL_TEMP=
  trap - EXIT INT TERM

  log "installed ${release_version} to ${final_root}"
  if [[ $announce_next != true ]]; then
    return 0
  fi
  next_command="openadkit setup --verify"
  case ":${PATH}:" in
    *":${launcher_dir}:"*) ;;
    *)
      next_command="${launcher_path} setup --verify"
      cat <<EOF
Add ${launcher_dir} to PATH, then start a new shell:
  echo 'export PATH="${launcher_dir}:\$PATH"' >> ~/.bashrc
EOF
      ;;
  esac
  printf 'Next: %s\n' "${next_command}"
}

install_openadkit() {
  # Kits find the release they extend under the same root (cli/manifest.py).
  local version=latest destination="${OPENADKIT_INSTALL_DIR:-${HOME}/.local/share/openadkit}" force=false
  local resolve_only=false announce_next=true

  while (($#)); do
    case "$1" in
      --version)
        (($# >= 2)) || usage_fail '--version requires a value'
        version=$2
        shift
        ;;
      --destination)
        (($# >= 2)) || usage_fail '--destination requires a value'
        destination=$2
        shift
        ;;
      --force) force=true ;;
      # Internal, for `openadkit upgrade` (cli/installation.py): print the
      # verified version the release metadata resolves to, or install without
      # the first-run guidance.
      --resolve) resolve_only=true ;;
      --no-next-steps) announce_next=false ;;
      -h|--help) install_usage; return 0 ;;
      *) usage_fail "unknown install option: $1" ;;
    esac
    shift
  done

  [[ $version == latest || $version =~ $OPENADKIT_VERSION_RE ]] \
    || usage_fail "invalid release version: ${version}"
  [[ $destination = /* ]] || usage_fail 'the install destination must be an absolute path'
  require_command curl
  require_command python3

  start_install_temp
  download_release_metadata "$version"
  [[ $version == latest || $version == "$RESOLVED_VERSION" ]] \
    || fail "release metadata is for ${RESOLVED_VERSION}, expected ${version}"
  if [[ $resolve_only == true ]]; then
    printf '%s\n' "$RESOLVED_VERSION"
    return 0
  fi

  require_command sha256sum
  require_command tar
  install_resolved_release \
    "$RESOLVED_VERSION" "$RESOLVED_ARCHIVE" "$RESOLVED_SHA256" "$destination" "$force" "$announce_next"
}

if [[ ${1:-} == install ]]; then
  shift
  install_openadkit "$@"
  exit 0
fi

SOURCE=${BASH_SOURCE[0]:-}
[[ -n $SOURCE ]] || fail 'Open AD Kit is not installed. Run: openadkit install'
SCRIPT_DIR=$(cd -- "$(dirname -- "$(readlink -f -- "$SOURCE")")" && pwd -P)

if [[ ${1:-} == upgrade || ${1:-} == uninstall ]]; then
  [[ -f "$SCRIPT_DIR/cli/installation.py" ]] || fail 'Open AD Kit is not installed. Run: openadkit install'
  require_command python3
  export OPENADKIT_ROOT="$SCRIPT_DIR"
  exec python3 "$SCRIPT_DIR/cli/installation.py" "$@"
fi

if [[ ${1:-} == setup ]]; then
  [[ -f "$SCRIPT_DIR/cli/setup.sh" ]] || fail 'Open AD Kit is not installed. Run: openadkit install'
  exec bash "$SCRIPT_DIR/cli/setup.sh" "$@"
fi

[[ -f "$SCRIPT_DIR/cli/main.py" ]] || fail 'Open AD Kit is not installed. Run: openadkit install'
if ! command -v python3 >/dev/null 2>&1; then
  printf 'python3 is required. Run: openadkit setup\n' >&2
  exit 1
fi

export OPENADKIT_ROOT="$SCRIPT_DIR"
exec python3 "$SCRIPT_DIR/cli/main.py" "$@"
