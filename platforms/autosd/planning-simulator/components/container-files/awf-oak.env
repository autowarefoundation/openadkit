# Shared environment for the Open AD Kit AutoSD quadlets.
# Single source of truth — change these here to apply them to every
# component at once (planning, simulator, ...) instead of editing each
# .container file. Installed to /etc/containers/systemd/awf-oak.env.
ROS_DOMAIN_ID=26
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ROSBAG2_STORAGE_DEFAULT_URI=/var/log/awf
