     bool LocalDisplay::render_frame(const cv::Mat& display_frame)
     {
+        // Create the GUI window lazily on the first frame we actually render.
+        // Opening it in the constructor makes VisionPilot abort on startup when
+        // no X display is available (e.g. headless containers), even when
+        // visualization is disabled and no frame is ever shown.
+        if (!window_created_)
+        {
+            cv::namedWindow("VisionPilot", cv::WINDOW_NORMAL);
+            window_created_ = true;
+        }
         cv::resizeWindow("VisionPilot", display_frame.cols, display_frame.rows);
         cv::imshow("VisionPilot", display_frame);
         cv::waitKey(1);
