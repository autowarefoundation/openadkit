[Unit]
Description=Open AD Kit X5H api component
Requires=awf-oak-x5h-extract-map.service
After=awf-oak-x5h-extract-map.service
After=awf-oak-map.service

[Install]
WantedBy=default.target

[Container]
Pod=awf-oak-x5h.pod
ContainerName=awf-oak-api
Image=${API_IMAGE}
EnvironmentFile=/etc/containers/systemd/awf-oak-x5h.env
Volume=/opt/tier4/kashiwanoha_map:/autoware_map:ro,Z
Volume=/etc/containers/systemd/cyclonedds-x5h.xml:/autoware/cyclonedds.xml:ro,Z
Volume=/etc/containers/systemd/default_adapi.param.yaml:/opt/autoware/share/autoware_default_adapi_universe/config/default_adapi.param.yaml:ro,Z
Exec=ros2 launch autoware_launch tier4_autoware_api_component.launch.xml \
  component_wise_launch:=true scenario_simulation:=${SCENARIO_SIMULATION} \
  use_sim_time:=${USE_SIM_TIME} vehicle_model:=${VEHICLE_MODEL}
