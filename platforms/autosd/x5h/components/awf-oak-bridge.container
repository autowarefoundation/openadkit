[Unit]
Description=Open AD Kit X5H bridge component
Wants=network-online.target
Requires=awf-oak-x5h-extract-map.service
Requires=rpmsg-eth.service
After=network-online.target
After=awf-oak-x5h-extract-map.service
After=awf-oak-map.service
After=rpmsg-eth.service
# rpmsg-eth.service brings up tap0 (domain 2's link to the CR52), and this
# container pins domain 2 to tap0 with autodetermine="false" and starts
# domain_bridge immediately. Without this Requires=/After= pair the bridge
# can race a tap0 that does not exist yet. rpmsg-eth.service is
# deliberately NOT enabled in this profile's boot preset (see
# rpmsg-dualboot.md), so this dependency documents the requirement and
# makes `systemctl start awf-oak-bridge` pull the link up itself rather
# than failing obscurely.

[Install]
WantedBy=default.target

[Container]
# NOT a member of awf-oak-x5h.pod, deliberately -- see the MEMBERSHIP note in
# awf-oak-x5h.pod. Quadlet's generated pod service Wants= every member, so
# with this unit in the pod, starting any single Autoware component also
# started the bridge, and "Autoware alone on domain 1" (the Stage 1
# isolation gate, enforced by x5h-stack-smoke.sh's bridge_active check)
# could not be reached by any choice of units.
#
# Network=host replaces exactly what pod membership used to supply: the pod
# itself declares Network=host, so its members were on the host namespace
# anyway. This is the load-bearing line for domain 2 -- tap0 is a host
# interface created by rpmsg-eth.service, and cyclonedds-x5h.xml pins domain
# 2 to it by name with autodetermine="false". Without host networking the
# bridge would come up in its own netns, tap0 would not exist there, and
# CycloneDDS would fail to find the configured interface. Domain 1 stays
# reachable on loopback for the same reason.
Network=host
ContainerName=awf-oak-bridge
Image=${BRIDGE_IMAGE}
EnvironmentFile=/etc/containers/systemd/awf-oak-x5h.env
Volume=/opt/tier4/kashiwanoha_map:/autoware_map:ro,z
Volume=/etc/containers/systemd/cyclonedds-x5h.xml:/autoware/cyclonedds.xml:ro,z
Volume=/etc/containers/systemd/bridge-config.yaml:/autoware/bridge-config.yaml:ro,Z
# No Exec=: the image entrypoint runs domain_bridge directly. The
# entrypoint treats any command it is given as a REPLACEMENT for the
# bridge (see components/bridge/entrypoint.sh), so setting Exec= here
# would silently stop domain_bridge from running instead of running
# alongside it.

[Service]
# NOT redundant with the [Container] copy above, and must not be deleted as
# such: Quadlet renames the source [Container] section to [X-Container] in
# the generated unit, and systemd ignores [X-Container] entirely. The
# [Container] copy therefore only becomes `podman run --env-file ...` (the
# container process's own environment). THIS copy is the one systemd reads,
# and systemd is what expands ${...} in the generated ExecStart -- without
# it Image=${..._IMAGE} expands to the empty string and podman exits with
# "repository name must have at least one component". Both are required;
# see awf-oak-x5h.pod for the full three-part reasoning.
EnvironmentFile=/etc/containers/systemd/awf-oak-x5h.env
Restart=on-failure
RestartSec=5
