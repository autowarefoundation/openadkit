[Unit]
Description=Open AD Kit X5H planning component
Wants=network-online.target
Requires=awf-oak-x5h-extract-map.service
After=network-online.target
After=awf-oak-x5h-extract-map.service
After=awf-oak-map.service

[Install]
WantedBy=default.target

[Container]
Pod=awf-oak-x5h.pod
ContainerName=awf-oak-planning
Image=${PLANNING_IMAGE}
EnvironmentFile=/etc/containers/systemd/awf-oak-x5h.env
Volume=/opt/tier4/kashiwanoha_map:/autoware_map:ro,z
Volume=/etc/containers/systemd/cyclonedds-x5h.xml:/autoware/cyclonedds.xml:ro,z
Exec=ros2 launch autoware_launch tier4_planning_component.launch.xml \
  component_wise_launch:=true enable_all_modules_auto_mode:=${ENABLE_ALL_MODULES_AUTO_MODE} \
  is_simulation:=${IS_SIMULATION_MODE} module_preset:=${PLANNING_MODULE_PRESET} \
  pointcloud_container_name:=${POINTCLOUD_CONTAINER_NAME} use_sim_time:=${USE_SIM_TIME} \
  vehicle_model:=${VEHICLE_MODEL}

[Service]
# NOT redundant with the [Container] copy above, and must not be deleted as
# such: Quadlet renames the source [Container] section to [X-Container] in
# the generated unit, and systemd ignores [X-Container] entirely. The
# [Container] copy therefore only becomes `podman run --env-file ...` (the
# container process's own environment). THIS copy is the one systemd reads,
# and systemd is what expands ${...} in the generated ExecStart -- without
# it Image=${..._IMAGE} expands to the empty string and podman exits with
# "repository name must have at least one component". Both are required;
# see awf-oak-x5h.pod for the full three-part reasoning.
EnvironmentFile=/etc/containers/systemd/awf-oak-x5h.env
Restart=on-failure
RestartSec=5
