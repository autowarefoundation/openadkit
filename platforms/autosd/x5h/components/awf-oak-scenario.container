[Unit]
Description=Open AD Kit X5H scenario runner
Wants=network-online.target
After=network-online.target
After=awf-oak-x5h-extract-map.service
After=awf-oak-api.service awf-oak-control.service awf-oak-simulator.service awf-oak-bridge.service

[Container]
Pod=awf-oak-x5h.pod
ContainerName=awf-oak-scenario
Image=${SCENARIO_SIMULATOR_IMAGE}
EnvironmentFile=/etc/containers/systemd/awf-oak-x5h.env
Volume=/var/log/awf:/var/log/awf:Z
Volume=/opt/tier4/kashiwanoha_map:/autoware_map:ro,z
Volume=/etc/containers/systemd/cyclonedds-x5h.xml:/autoware/cyclonedds.xml:ro,z
Exec=bash -lc 'exec ros2 launch scenario_test_runner scenario_test_runner.launch.py \
  architecture_type:=${ARCHITECTURE_TYPE} global_frame_rate:=${GLOBAL_FRAME_RATE} \
  global_timeout:=${GLOBAL_TIMEOUT} initialize_duration:=${INITIALIZE_DURATION} \
  launch_autoware:=${LAUNCH_AUTOWARE} launch_rviz:=${LAUNCH_RVIZ} \
  launch_visualization:=${LAUNCH_VISUALIZATION} output_directory:=${OUTPUT_DIRECTORY} \
  record:=${RECORD} scenario:="$(ros2 pkg prefix --share scenario_test_runner)/scenario/sample.yaml" \
  sensor_model:=${SENSOR_MODEL} use_custom_centerline:=${USE_CUSTOM_CENTERLINE} \
  use_sim_time:=${USE_SIM_TIME} vehicle_model:=${VEHICLE_MODEL}'

[Service]
# NOT redundant with the [Container] copy above, and must not be deleted as
# such: Quadlet renames the source [Container] section to [X-Container] in
# the generated unit, and systemd ignores [X-Container] entirely. The
# [Container] copy therefore only becomes `podman run --env-file ...` (the
# container process's own environment). THIS copy is the one systemd reads,
# and systemd is what expands ${...} in the generated ExecStart -- without
# it Image=${..._IMAGE} expands to the empty string and podman exits with
# "repository name must have at least one component". Both are required;
# see awf-oak-x5h.pod for the full three-part reasoning.
EnvironmentFile=/etc/containers/systemd/awf-oak-x5h.env
Type=oneshot
RemainAfterExit=yes
