[Unit]
Description=Open AD Kit X5H simulator component
Wants=network-online.target
Requires=awf-oak-x5h-extract-map.service
After=network-online.target
After=awf-oak-x5h-extract-map.service
After=awf-oak-map.service awf-oak-system.service awf-oak-vehicle.service

[Install]
WantedBy=default.target

[Container]
Pod=awf-oak-x5h.pod
ContainerName=awf-oak-simulator
Image=${SIMULATOR_IMAGE}
# Pull=never, on all nine units: every *_IMAGE in awf-oak-x5h.env is a
# localhost/* ref, which podman reads as a registry named "localhost",
# NOT as "use the local store only". A staged image hides that, because
# the local store satisfies the reference first; a MISSING one does not,
# and podman then retries HTTPS to localhost three times and reports a
# TLS/registry error instead of saying the image is absent. See the
# *_IMAGE note in awf-oak-x5h.env.
Pull=never
EnvironmentFile=/etc/containers/systemd/awf-oak-x5h.env
Volume=/opt/tier4/kashiwanoha_map:/autoware_map:ro,z
Volume=/etc/containers/systemd/cyclonedds-x5h.xml:/autoware/cyclonedds.xml:ro,z
# raw_vehicle_cmd_converter_param_path and vehicle_info_param_file below
# both target the ISOLATED colcon install layout
# (/opt/autoware/<pkg>/share/<pkg>/...), not a merged one -- same
# reasoning as the Volume= lines above, and matching the form the
# sibling fix/component-images-autoware-launch branch landed in its
# docker-compose.yaml. autoware_launch is not yet in any staged image
# (a separate branch adds it), so raw_vehicle_cmd_converter_param_path
# is derived, not measured. ${VEHICLE_MODEL}_description IS the right
# package name for vehicle_info_param_file (autoware_core 1.8.0 ships
# the prefixed autoware_sample_vehicle_description); VEHICLE_MODEL
# itself stays sample_vehicle because vehicle.launch.xml separately
# resolves the unprefixed $(var vehicle_model)_launch, which is why the
# sibling branch is adding vehicle/sample_vehicle_launch rather than
# reprefixing VEHICLE_MODEL.
Exec=ros2 launch autoware_launch tier4_simulator_component.launch.xml \
  initial_engage_state:=${INITIAL_ENGAGE_STATE} launch_dummy_doors:=${LAUNCH_DUMMY_DOORS} \
  launch_dummy_perception:=${LAUNCH_DUMMY_PERCEPTION} launch_dummy_vehicle:=${LAUNCH_DUMMY_VEHICLE} \
  launch_scenario_simulator_v2_adapter:=${LAUNCH_SCENARIO_SIMULATOR_V2_ADAPTER} \
  localization_sim_mode:=${LOCALIZATION_SIM_MODE} \
  perception/enable_detection_failure:=${PERCEPTION_ENABLE_DETECTION_FAILURE} \
  perception/enable_object_recognition:=${PERCEPTION_ENABLE_OBJECT_RECOGNITION} \
  perception/enable_traffic_light:=${PERCEPTION_ENABLE_TRAFFIC_LIGHT} \
  perception/use_base_link_z:=${PERCEPTION_USE_BASE_LINK_Z} \
  raw_vehicle_cmd_converter_param_path:=/opt/autoware/autoware_launch/share/autoware_launch/config/vehicle/raw_vehicle_cmd_converter/raw_vehicle_cmd_converter.param.yaml \
  scenario_simulation:=${SCENARIO_SIMULATION} sensing/visible_range:=${SENSING_VISIBLE_RANGE} \
  use_sim_time:=${USE_SIM_TIME} use_pointcloud_container:=${USE_POINTCLOUD_CONTAINER} \
  vehicle_info_param_file:=/opt/autoware/${VEHICLE_MODEL}_description/share/${VEHICLE_MODEL}_description/config/vehicle_info.param.yaml \
  vehicle_model:=${VEHICLE_MODEL}

[Service]
# NOT redundant with the [Container] copy above, and must not be deleted as
# such: Quadlet renames the source [Container] section to [X-Container] in
# the generated unit, and systemd ignores [X-Container] entirely. The
# [Container] copy therefore only becomes `podman run --env-file ...` (the
# container process's own environment). THIS copy is the one systemd reads,
# and systemd is what expands ${...} in the generated ExecStart -- without
# it Image=${..._IMAGE} expands to the empty string and podman exits with
# "repository name must have at least one component". Both are required;
# see awf-oak-x5h.pod for the full three-part reasoning.
EnvironmentFile=/etc/containers/systemd/awf-oak-x5h.env
Restart=on-failure
RestartSec=5
