[Unit]
Description=Open AD Kit X5H system component
Wants=network-online.target
Requires=awf-oak-x5h-extract-map.service
After=network-online.target
After=awf-oak-x5h-extract-map.service
After=awf-oak-map.service

[Install]
WantedBy=default.target

[Container]
Pod=awf-oak-x5h.pod
ContainerName=awf-oak-system
Image=${VEHICLE_SYSTEM_IMAGE}
# Pull=never, on all nine units: every *_IMAGE in awf-oak-x5h.env is a
# localhost/* ref, which podman reads as a registry named "localhost",
# NOT as "use the local store only". A staged image hides that, because
# the local store satisfies the reference first; a MISSING one does not,
# and podman then retries HTTPS to localhost three times and reports a
# TLS/registry error instead of saying the image is absent. See the
# *_IMAGE note in awf-oak-x5h.env.
Pull=never
EnvironmentFile=/etc/containers/systemd/awf-oak-x5h.env
Volume=/opt/tier4/kashiwanoha_map:/autoware_map:ro,z
Volume=/etc/containers/systemd/cyclonedds-x5h.xml:/autoware/cyclonedds.xml:ro,z
# Mount target is the ISOLATED colcon install layout, not a merged one:
# every staged image lacks /opt/autoware/share, and each package installs
# under its own /opt/autoware/<pkg>/share/<pkg>/... instead -- confirmed
# on the board for the analogous default_adapi.param.yaml and
# control.launch.xml overrides. autoware_launch (the package this file
# targets) is not yet in any staged image -- a separate branch adds it --
# so this path is DERIVED from that layout, not independently measured;
# confirm it once autoware_launch lands by checking
# /opt/autoware/autoware_launch/share/autoware_launch/config/system/mrm_handler/
# in VEHICLE_SYSTEM_IMAGE.
Volume=/etc/containers/systemd/mrm_handler.param.yaml:/opt/autoware/autoware_launch/share/autoware_launch/config/system/mrm_handler/mrm_handler.param.yaml:ro,Z
Exec=ros2 launch autoware_launch tier4_system_component.launch.xml \
  launch_system_monitor:=${LAUNCH_SYSTEM_MONITOR} launch_dummy_diag_publisher:=${LAUNCH_DUMMY_DIAG_PUBLISHER} \
  sensor_model:=${SENSOR_MODEL} system_run_mode:=${SYSTEM_RUN_MODE} \
  use_sim_time:=${USE_SIM_TIME} vehicle_model:=${VEHICLE_MODEL}

[Service]
# NOT redundant with the [Container] copy above, and must not be deleted as
# such: Quadlet renames the source [Container] section to [X-Container] in
# the generated unit, and systemd ignores [X-Container] entirely. The
# [Container] copy therefore only becomes `podman run --env-file ...` (the
# container process's own environment). THIS copy is the one systemd reads,
# and systemd is what expands ${...} in the generated ExecStart -- without
# it Image=${..._IMAGE} expands to the empty string and podman exits with
# "repository name must have at least one component". Both are required;
# see awf-oak-x5h.pod for the full three-part reasoning.
EnvironmentFile=/etc/containers/systemd/awf-oak-x5h.env
Restart=on-failure
RestartSec=5
