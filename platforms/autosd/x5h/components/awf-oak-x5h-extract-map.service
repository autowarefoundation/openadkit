[Install]
WantedBy=default.target

[Unit]
# NOT named awf-oak-map.service: awf-oak-map.container generates a unit of
# that name on this profile, and planning-simulator's extractor already
# uses it. Two units with one name is a silent override, not an error.
Description=Open AD Kit X5H Kashiwanoha Map Extractor
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/containers/systemd/awf-oak-x5h.env
# /usr/libexec, not /usr/local/libexec: automotive-image-builder refuses to
# install anything under /usr/local ("not allowed ... but not under
# /usr/local/"), because on this ostree-structured rootfs /usr/local is a
# symlink to ../var/usrlocal. aib/x5h-rootfs.aib.yml installs this script at
# the path below; keep the two in step.
ExecStart=/usr/bin/bash /usr/libexec/awf-oak-x5h-extract-map.sh
