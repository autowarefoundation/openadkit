# Board copy of deployments/samples/scenario-simulation/scenario-simulation.env.
# Referenced by every Quadlet unit via EnvironmentFile=, so a value is
# changed here once instead of in nine unit files.
#
# Deltas from the sample, each deliberate:
#   RMW_IMPLEMENTATION -> added. The sample sets it per-service in compose
#                         rather than in the env file; our units share one
#                         EnvironmentFile=, so it is consolidated here.
#                         Without it, CYCLONEDDS_URI would be a no-op if
#                         the image's default RMW were not CycloneDDS.
#   CYCLONEDDS_URI     -> added; the sample relies on defaults, the board
#                         cannot (domain 2 must be pinned to tap0).
#   AUTO_EXTRACT_MAP   -> CHANGED, not added: the sample sets it to true and
#                         this profile pins it FALSE. That flip is the
#                         human-ruled decision in this file and the single
#                         line here most worth recording, because
#                         awf-oak-x5h-extract-map.service -- a dedicated
#                         one-shot -- owns map extraction on this profile
#                         and nothing else may race it. See its own
#                         annotation below: nothing on this profile actually
#                         reads the variable, so the pin is defensive.
#   MAP_PATH           -> changed from the sample's
#                         $HOME/autoware_map/kashiwanoha_map to
#                         /opt/tier4/kashiwanoha_map, where
#                         awf-oak-x5h-extract-map.service puts the map. Also
#                         not consumed on this profile -- see its annotation
#                         below.
#   *_IMAGE            -> localhost/* names rather than registry refs, so the
#                         board never pulls. The six in images.txt are staged
#                         by stage-container-images.sh; BRIDGE_IMAGE is the
#                         exception -- no registry publishes it, so it is
#                         built and `podman load`ed by the recipe in
#                         bridge/Dockerfile.
#   OUTPUT_DIRECTORY   -> changed from the sample's
#                         /autoware/scenario-sim/output to
#                         /var/log/awf/scenario-output: matches the
#                         scenario unit's Volume=/var/log/awf:/var/log/awf:Z,
#                         the directory the image manifest creates, and the
#                         path the board smoke script reads the junit
#                         result from. This is the plan's verdict path, so
#                         an unexplained change here would be drift worth
#                         catching.
#   SCENARIO_READY_TIMEOUT, OUTPUT_HOST_PATH, SCENARIO_HOST_DIR -> dropped,
#                         all compose-only. SCENARIO_READY_TIMEOUT is
#                         consumed only by compose's inline readiness
#                         wrapper; our Quadlet scenario unit runs
#                         scenario_test_runner directly. OUTPUT_HOST_PATH
#                         and SCENARIO_HOST_DIR are compose bind-mount
#                         sources; Quadlet declares Volume= explicitly.
#   REMOTE_DISPLAY, RVIZ_CONFIG -> dropped. Both only configure the
#                         sample's visualizer service, which this profile
#                         does not run: the board is headless and the
#                         verdict is a junit file, so there is no display to
#                         forward and no RViz to configure.
#   visualizer         -> absent, for the same reason. Named explicitly
#                         alongside the two variables above so the drop is
#                         a recorded decision rather than something a reader
#                         has to infer from a missing service.

# ROS settings
ROS_DOMAIN_ID=1
USE_SIM_TIME=true
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
CYCLONEDDS_URI=file:///autoware/cyclonedds.xml

# Common settings
POINTCLOUD_CONTAINER_NAME=pointcloud_container
SCENARIO_SIMULATION=true
SENSOR_MODEL=sample_sensor_kit
VEHICLE_ID=default
VEHICLE_MODEL=sample_vehicle

# Images (loaded on the board by stage-container-images.sh)
MAP_IMAGE=localhost/openadkit-localization-mapping:latest
PLANNING_IMAGE=localhost/openadkit-planning-control:latest
VEHICLE_SYSTEM_IMAGE=localhost/openadkit-vehicle-system:latest
API_IMAGE=localhost/openadkit-api:latest
SIMULATOR_IMAGE=localhost/openadkit-simulator:latest
SCENARIO_SIMULATOR_IMAGE=localhost/scenario-simulator-v2:latest
BRIDGE_IMAGE=localhost/openadkit-bridge:latest

# Map settings
# Not consumed on this profile (AUTO_EXTRACT_MAP and MAP_PATH both): their
# only consumer in this repo is deployments/common/scripts/map-init.sh,
# which the compose sample bind-mounts into a map-init service straight from
# the working tree -- it is not baked into any image, and this profile runs
# no equivalent service. Extraction is owned entirely by
# awf-oak-x5h-extract-map.service, which hardcodes the path rather than
# reading MAP_PATH (the same path is also hardcoded in nine unit Volume=
# lines, so pointing the script at the variable would only move the
# duplication, not remove it).
#
# AUTO_EXTRACT_MAP is therefore pinned false DEFENSIVELY, not to override an
# image default: there is no image default to override, because nothing in
# any staged image reads it. It is pinned so that if a future change does
# introduce a map-init-style step on this profile, that step inherits
# "do not extract" from this file instead of silently racing the one-shot
# that already owns the map directory.
AUTO_EXTRACT_MAP=false
LANELET2_MAP_FILE=lanelet2_map.osm
MAP_PATH=/opt/tier4/kashiwanoha_map
POINTCLOUD_MAP_FILE=pointcloud_map.pcd

# Planning settings
ENABLE_ALL_MODULES_AUTO_MODE=false
IS_SIMULATION_MODE=true
PLANNING_MODULE_PRESET=default

# Control settings
CHECK_EXTERNAL_EMERGENCY_HEARTBEAT=false
CONTROL_MODULE_PRESET=default
LATERAL_CONTROLLER_MODE=mpc
LONGITUDINAL_CONTROLLER_MODE=pid

# Vehicle interface
LAUNCH_VEHICLE_INTERFACE=true

# System settings
SYSTEM_RUN_MODE=planning_simulation
LAUNCH_SYSTEM_MONITOR=false
LAUNCH_DUMMY_DIAG_PUBLISHER=true

# Simulator settings
INITIAL_ENGAGE_STATE=true
LAUNCH_DUMMY_DOORS=true
LAUNCH_DUMMY_PERCEPTION=false
LAUNCH_DUMMY_VEHICLE=false
LAUNCH_SCENARIO_SIMULATOR_V2_ADAPTER=true
LOCALIZATION_SIM_MODE=api
PERCEPTION_ENABLE_DETECTION_FAILURE=true
PERCEPTION_ENABLE_OBJECT_RECOGNITION=true
PERCEPTION_ENABLE_TRAFFIC_LIGHT=false
PERCEPTION_USE_BASE_LINK_Z=true
SENSING_VISIBLE_RANGE=300.0
USE_POINTCLOUD_CONTAINER=false

# Scenario simulator settings
LAUNCH_AUTOWARE=false
LAUNCH_RVIZ=false
LAUNCH_VISUALIZATION=false
USE_CUSTOM_CENTERLINE=true
ARCHITECTURE_TYPE=awf/universe/20250130
# Not consumed on this profile: awf-oak-scenario.container computes the
# scenario path itself via `ros2 pkg prefix --share scenario_test_runner`
# and passes it directly as scenario:=, so setting this has no effect here.
SCENARIO=
INITIALIZE_DURATION=90
GLOBAL_FRAME_RATE=30
GLOBAL_TIMEOUT=180
OUTPUT_DIRECTORY=/var/log/awf/scenario-output
RECORD=false
