# Shared environment for the five Quadlet units of the X5H Autoware stack.
# Referenced by every unit via EnvironmentFile= in BOTH its [Container] and
# its [Service] section, so a value is changed here once instead of in five
# unit files.
#
# WHY BOTH SECTIONS, since this is the thing most likely to be "cleaned up":
# Quadlet renames the source [Container] section to [X-Container] in the
# generated unit and systemd ignores [X-Container] entirely. The [Container]
# copy therefore only becomes `podman run --env-file ...`, i.e. the
# container process's own environment. The [Service] copy is the one systemd
# reads, and systemd is what expands the ${...} references in the generated
# ExecStart -- including Image=${AUTOWARE_IMAGE}. Delete it and every
# expansion is the empty string, podman exits with "repository name must
# have at least one component", and the board smoke reports a plain
# unit_inactive with no hint that an env file is involved. Check the
# invariant by PARSING the generated [Service] section; a grep of the source
# file finds the [Container] copy and wrongly reports the unit healthy.
#
# The units are a Quadlet translation of the working CES2026 demo of this
# exact topology (/home/test/youtalk/CES2026/MRM_repo/run.yml), so the
# reference for every value below is that compose file rather than
# deployments/samples/scenario-simulation. Compose service -> unit:
#   bridge      -> awf-oak-bridge      (image built from components/bridge)
#   planning    -> awf-oak-autoware
#   simulator   -> awf-oak-simulator
#   visualizer  -> not carried across; the board is headless and the verdict
#                  is a junit file, so there is no display to forward. With
#                  it goes run.yml's `depends_on: visualizer` edge, which has
#                  no Quadlet equivalent to re-express.
# awf-oak-relay and awf-oak-restamp have no compose counterpart: they exist
# because the CR52 link needs a downsampled trajectory and a restamped
# control_cmd (see components/bridge/bridge-config.yaml).

# ROS settings
ROS_DOMAIN_ID=1
# USE_SIM_TIME IS FALSE AND MUST STAY FALSE. It was true here for the
# retired component stack; that was wrong for this topology and is now a
# resolved contradiction, not a preference:
#   1. Wall clock is the only configuration ever observed to engage and
#      drive on this topology. run.yml launches with use_sim_time:=false and
#      leaves the runner's USE_SIM_TIME unset (its entrypoint defaults it to
#      false).
#   2. planning_simulator.launch.xml declares
#      `<arg name="use_sim_time" default="$(var scenario_simulation)"/>`, so
#      with SCENARIO_SIMULATION=true below, NOT passing this argument would
#      silently select sim time.
#   3. Nothing in this stack publishes /clock. Under sim time
#      components/nodes/control_restamp.py -- whose job is to overwrite the
#      CR52's FreeRTOS uptime stamps with domain 1's clock -- would read a
#      clock that never ticks, stamp every command zero, and reintroduce the
#      exact staleness it exists to remove, while still running and still
#      publishing.
USE_SIM_TIME=false
# Required. Neither monolithic image sets RMW_IMPLEMENTATION for
# non-login shells: it is exported only from /root/.bashrc, and
# /ros_entrypoint.sh does not export it. Without it CYCLONEDDS_URI below
# would be a no-op against whatever RMW the image defaults to.
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# Points at the file every unit mounts at /autoware/cyclonedds.xml.
#
# The reason for mounting our own config is now POSITIVE, not defensive.
# The retired component images shipped a cyclonedds.xml requesting a 10 MB
# SocketReceiveBufferSize that this board's rmem_max could not satisfy, and
# overriding it was the point. These images ship no cyclonedds.xml at all
# and set no CYCLONEDDS_URI (measured: `find / -xdev -name "cyclonedds*.xml"`
# returns nothing in either). We mount ours because domain 2 must be pinned
# to tap0 with a static peer at 172.16.52.2 and a 1344B FragmentSize, and
# CycloneDDS defaults will not do any of that.
CYCLONEDDS_URI=file:///autoware/cyclonedds.xml

# Vehicle and sensor model, consumed by awf-oak-autoware's launch arguments
# and by the scenario runner's entrypoint.
#
# The UNPREFIXED values are correct for these images and must not be
# "modernised" to autoware_sample_vehicle / autoware_sample_sensor_kit.
# Measured: /opt/autoware/share holds sample_vehicle_description,
# sample_vehicle_launch, sample_sensor_kit_description and
# sample_sensor_kit_launch, and no autoware_-prefixed variant of any of
# them. (The retired componentized images shipped the prefixed pair, which
# is where the temptation comes from.)
SENSOR_MODEL=sample_sensor_kit
VEHICLE_MODEL=sample_vehicle
# scenario_simulation:=true on planning_simulator.launch.xml. See the
# USE_SIM_TIME note above for the argument this one silently controls.
SCENARIO_SIMULATION=true

# Images.
#
# THESE ARE THE NAMES THE IMAGES ACTUALLY CARRY ON THE BOARD, verified with
# `podman images` rather than assumed. They were loaded from OCI archives
# that kept their registry reference as the tag, so they are NOT
# localhost/universe-after:latest and localhost/scenario-simulator:latest.
# scripts/stage-container-images.sh, which is what images.txt drives, would
# instead retag them to localhost/<local-name>:latest -- so if these two
# images are ever added to images.txt and re-staged through that script,
# these two lines must change with it. images.txt and that script are
# updated in a separate change; the two files have to agree.
#
# Registry provenance (pin by digest when re-staging; note that the digest
# `podman images --digests` reports on the board DIFFERS, because
# `skopeo copy` to oci-archive rewrites the manifest to OCI media types --
# content identity was checked instead via matching rootfs.diff_ids):
#   universe-after-arm64      ghcr.io/mitsudome-r/mrm-demo
#     sha256:d161659c110c0a27522468a3e5318bed11bfab75a763f8c01075da6916ea18b2
#   scenario-simulator-arm64  ghcr.io/mitsudome-r/mrm-demo
#     sha256:3295e51b3f216e663ddbfa004431edac0e01a57e4c170edb2753217ec02583f3
AUTOWARE_IMAGE=ghcr.io/mitsudome-r/mrm-demo:universe-after-arm64
SCENARIO_SIMULATOR_IMAGE=ghcr.io/mitsudome-r/mrm-demo:scenario-simulator-arm64
# The one image no registry publishes: built from components/bridge/Dockerfile
# as a thin layer on AUTOWARE_IMAGE and `podman load`ed onto the board. The
# recipe is in that Dockerfile; images.txt cannot stage it, because it has
# no registry ref.
BRIDGE_IMAGE=localhost/openadkit-bridge:latest

# Scenario runner settings. Every variable in this block is read by the
# scenario-simulator image's /entrypoint.sh, which is the ONLY way to
# configure awf-oak-simulator: that entrypoint runs the scenario only when
# it is given no arguments, so the unit sets no Exec= and these ten
# variables are its entire interface. Adding a variable here that the
# entrypoint does not read configures nothing.
ARCHITECTURE_TYPE=awf/universe/20250130
# Absolute IN-CONTAINER path, passed straight through as the runner's
# scenario:= argument. Satisfied by awf-oak-simulator's
# /etc/containers/systemd/mrm-scenario.yaml file mount. The scenario itself
# hard-codes /autoware/scenario-sim/map/{lanelet2_map.osm,pointcloud_map.pcd}
# for its road network, which the /var/lib/awf/scenario-sim directory mount
# satisfies -- the three paths are one layout and move together.
SCENARIO=/autoware/scenario-sim/mrm-scenario.yaml
GLOBAL_FRAME_RATE=30
GLOBAL_TIMEOUT=180
INITIALIZE_DURATION=90
# The verdict path, and the reason it is not the reference demo's default.
# Leaving OUTPUT_DIRECTORY unset would put the junit result in
# /autoware/scenario-sim/output, inside the scenario directory. This
# milestone's pass criterion IS the junit file, so it gets a path of its own
# that does not move if the scenario layout changes: it matches
# awf-oak-simulator's Volume=/var/log/awf:/var/log/awf:Z, the directory the
# image manifest creates, and the path the board smoke script reads. An
# unexplained change here is drift worth catching.
OUTPUT_DIRECTORY=/var/log/awf/scenario-output
RECORD=false
