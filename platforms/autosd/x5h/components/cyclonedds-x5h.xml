<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">

  <!-- Sizing note (applies to both domains' <Sizing> blocks below):
       ReceiveBufferSize and ReceiveBufferChunkSize are CycloneDDS's
       internal receive-buffer pool, a different setting from
       General/SocketReceiveBufferSize below, which is a request to the
       kernel for a larger SO_RCVBUF on the underlying socket. The values
       here (16384B / 2048B) are carried over unchanged from the CR52-side
       DDS configuration this file was written to interoperate with, so that
       both ends of the domain-2 link size their receive pools the same way.
       They are internally coherent: 16384 is an exact multiple of 2048, and
       the chunk size exceeds both tap0's 462-byte fragment size and the
       1400B MaxMessageSize. Whether this pool is thin for six bridged
       topics is an open question worth flagging here, not retuning in this
       file.

       This file deliberately does NOT set General/SocketReceiveBufferSize.
       The stock component images ship a cyclonedds.xml that requests
       <SocketReceiveBufferSize min="10MB"/>; net.core.rmem_max is 212992
       bytes (208KB) on both the companion host and the board, so that
       request fails the kernel's setsockopt and CycloneDDS aborts at
       participant creation instead of degrading gracefully. Do not paste
       SocketReceiveBufferSize back into this file. -->

  <!-- Domain 1: the Open AD Kit component containers. They share the host
       network namespace, so discovery stays on the loopback path. -->
  <Domain id="1">
    <General>
      <AllowMulticast>spdp</AllowMulticast>
      <MaxMessageSize>1400B</MaxMessageSize>
      <Interfaces>
        <NetworkInterface autodetermine="true" priority="default" multicast="default" />
      </Interfaces>
    </General>
    <Sizing>
      <ReceiveBufferSize>16384B</ReceiveBufferSize>
      <ReceiveBufferChunkSize>2048B</ReceiveBufferChunkSize>
    </Sizing>
    <Discovery>
      <ParticipantIndex>none</ParticipantIndex>
    </Discovery>
  </Domain>

  <!-- Domain 2: the CR52 actuation module, reached over the rpmsg-eth link.
       tap0 is a point-to-point link with no multicast, so SPDP has nowhere
       to multicast and the peer is configured statically. The CR52 side has
       carried static peers since M6, so both ends of the link agree.

       MaxMessageSize stays at 1400B: RTPS fragmentation down to tap0's
       462-byte MTU happens below this setting, and lowering it here would
       double-fragment for no benefit.

       The ${X5H_SI_INTERFACE:-tap0} / ${X5H_SI_PEER:-172.16.52.2} defaults
       exist so a later host rehearsal can retarget domain 2 at a veth rig
       without a second copy of this file. On the board both defaults are
       correct and neither variable is set. -->
  <Domain id="2">
    <General>
      <AllowMulticast>false</AllowMulticast>
      <MaxMessageSize>1400B</MaxMessageSize>
      <Interfaces>
        <NetworkInterface autodetermine="false" priority="default" multicast="false" name="${X5H_SI_INTERFACE:-tap0}"/>
      </Interfaces>
    </General>
    <Sizing>
      <ReceiveBufferSize>16384B</ReceiveBufferSize>
      <ReceiveBufferChunkSize>2048B</ReceiveBufferChunkSize>
    </Sizing>
    <Discovery>
      <ParticipantIndex>none</ParticipantIndex>
      <Peers>
        <Peer address="${X5H_SI_PEER:-172.16.52.2}"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
