<?xml version="1.0" encoding="UTF-8" ?>
<!-- CES 2027 demo role. Domain 1 is the bench LAN (CARLA and the bridge nodes
     on rog-amd, VisionPilot, the heartbeat and restamp nodes on this board):
     pinned to tsn5 so autodetermine can never pick tap0. Domain 2 is the
     CR52 link and is copied verbatim from components/cyclonedds-x5h.xml
     (its own note there: net.core.rmem_max is 212992B on this board, so
     General/SocketReceiveBufferSize must never be added here either — see
     that file's header comment for the full story). -->
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="1">
    <General>
      <Interfaces><NetworkInterface name="${X5H_D1_INTERFACE:-tsn5}" priority="default" multicast="true"/></Interfaces>
      <AllowMulticast>spdp</AllowMulticast>
      <MaxMessageSize>65500B</MaxMessageSize>
    </General>
  </Domain>
  <Domain id="2">
    <General>
      <AllowMulticast>false</AllowMulticast>
      <MaxMessageSize>1400B</MaxMessageSize>
      <FragmentSize>1344B</FragmentSize>
      <Interfaces>
        <NetworkInterface autodetermine="false" priority="default" multicast="false" name="${X5H_SI_INTERFACE:-tap0}"/>
      </Interfaces>
    </General>
    <Sizing>
      <ReceiveBufferSize>16384B</ReceiveBufferSize>
      <ReceiveBufferChunkSize>2048B</ReceiveBufferChunkSize>
    </Sizing>
    <Discovery>
      <ParticipantIndex>none</ParticipantIndex>
      <Peers>
        <Peer address="${X5H_SI_PEER:-172.16.52.2}"/>
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
