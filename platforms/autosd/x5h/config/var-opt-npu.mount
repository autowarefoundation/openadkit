[Unit]
Description=X5H NPU work partition (UFS partlabel npu-work) at /opt/npu
ConditionKernelCommandLine=x5h.role=npu
# demo boots the derived demo dtb, which carries the NPU regions alongside
# the relocated CR52 carveout, so /opt/npu belongs there too. Repeated
# ConditionKernelCommandLine= lines are OR'ed by systemd.
ConditionKernelCommandLine=x5h.role=demo
After=local-fs-pre.target
DefaultDependencies=no

[Mount]
What=/dev/disk/by-partlabel/npu-work
Where=/var/opt/npu
Type=ext4
Options=defaults,nofail

[Install]
WantedBy=local-fs.target
