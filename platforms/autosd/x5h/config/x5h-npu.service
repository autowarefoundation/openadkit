[Unit]
Description=X5H NPU bring-up (cmemdrv, /dev/npuc*) in the demo and dev roles
# demo and dev boot the identical derived device tree, so this unit belongs
# under both. Repeated conditions of one type are ANDed by systemd, so each
# role line carries a pipe after the equals sign to make it a triggering
# condition: the unit runs when at least one triggering condition matches.
ConditionKernelCommandLine=|x5h.role=demo
ConditionKernelCommandLine=|x5h.role=dev
Requires=var-opt-npu.mount
After=var-opt-npu.mount systemd-modules-load.service systemd-udev-settle.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/x5h-npu-up.sh

[Install]
WantedBy=multi-user.target
