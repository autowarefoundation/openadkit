# AutoSD-alignment fragment, layered over x5h-board.config (the board's own
# IKCONFIG-extracted config) by build-bsp-kernel.sh. Each block names the
# AutoSD feature that requires it. Everything not listed here stays exactly
# as the board kernel shipped it.

# Identity: distinguishes this kernel from the BSP one everywhere that
# matters (uname -r, /lib/modules/<ver>, TFTP artifact names).
CONFIG_LOCALVERSION="-autosd"
# LOCALVERSION_AUTO would append a git suffix and break the fixed
# 6.1.102-autosd name the staging scripts key on.
# CONFIG_LOCALVERSION_AUTO is not set

# --- PCIe6 firmware: the ONE place the board's config cannot be rebuilt
# --- from public source. The board ships
# --- CONFIG_EXTRA_FIRMWARE="rcar_gen5_mp_phy.bin rcar_gen5_pcie6_iccm.bin
# --- rcar_gen5_pcie6_dccm.bin", which bakes three Renesas blobs into the
# --- image. renesas-rcar/linux-bsp does not carry them (they ship only in
# --- the NDA R-Car xOS SDK), so kbuild dies with "No rule to make target
# --- 'firmware/rcar_gen5_mp_phy.bin'" -- observed in the first CI cycle on
# --- this branch. Emptying the list here keeps NDA binaries out of CI; the
# --- board image restores the ONE blob netboot actually requires
# --- (rcar_gen5_mp_phy.bin -- the MP-PHY probe feeds the TSN link NFS root
# --- depends on, proven 2026-08-05) via board-firmware.config, merged only
# --- by --firmware local builds. This is the one-build-two-images split:
# --- same source, same toolchain, config delta = this symbol only.
# --- Safe here, on evidence rather than hope: all three are requested
# --- exclusively by drivers/pci/controller/dwc/pcie6-rcar-gen5.c (pcie4-rcar
# --- is a different driver and needs none), and the board's own BSP kernel
# --- loads them only to report "pcie6-rcar da000000.pcie: Phy link never
# --- came up" -- nothing is attached to PCIe6 as this board is configured.
# --- Nothing this platform does goes through it: netboot is TSN ethernet
# --- (tsn5) and storage is UFS (sda-sdd, incl. the 32 GB autosd-store LUN)
# --- plus eMMC. If a later phase needs PCIe6, add the two PCIe6 blobs to
# --- board-firmware.config -- CI still never sees any blob.
CONFIG_EXTRA_FIRMWARE=""

# --- SELinux: AutoSD userspace ships selinux-policy and selinux-bools.service
# --- (which FAILS on the BSP kernel — observed in gate cycle 3). Permissive
# --- on NFS root by design; enforcing is a later, local-storage phase.
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
# Keeps the documented selinux=0 fallback bootarg functional.
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
# Permits permissive mode and the enforcing=0 bootarg.
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
# The board's LSM list with selinux inserted; order otherwise preserved.
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,integrity,bpf"

# --- ext4 security xattrs: the container-store blocker (pre-flight survey;
# --- GATE2 flips from FAIL_OK to OK on this one symbol).
CONFIG_EXT4_FS_SECURITY=y

# --- nftables: netavark 2.0.0 dropped the iptables backend entirely; its
# --- nftables driver needs nf_tables plus the nat/masq/ct expression
# --- modules. NF_CONNTRACK/NF_NAT parents are already =m on the board.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
# conntrack marks: netavark both matches and SETS `ct mark` -- nft.rs builds
# CT expressions with "state" and "mark" keys, plus Mangle statements that
# assign them. Unlike everything else in this block this is a bool compiled
# into nf_conntrack, not a module, so no amount of modprobing substitutes
# for it, and the board's base config ships it off. Without it the kernel
# rejects the `ct mark` expression; because netavark applies its whole
# ruleset in ONE atomic transaction, that refuses the entire ruleset with a
# single opaque line naming neither rule nor expression:
#   internal:0:0-0: Error: Could not process rule: Operation not supported
# It cost three CI cycles to pin down, because every other expression the
# ruleset uses IS supported here, and `ct state` -- the obvious thing to
# reach for -- is available whether or not this symbol is set. GATE6's
# nft_probe now tests `ct mark` specifically so a regression names itself.
CONFIG_NF_CONNTRACK_MARK=y
# fib: NOT optional, and not obvious from a capability survey -- it comes
# straight from netavark 2.0.0's own ruleset. src/firewall/nft.rs builds its
# port-forwarding entry points as, verbatim from its comments:
#     Prerouting: fib daddr type local jump NETAVARK-HOSTPORT-DNAT
#     Output:     fib daddr type local jump NETAVARK-HOSTPORT-DNAT
# Without the fib expression the kernel cannot resolve those two rules, and
# nft fails the WHOLE transaction with "Could not process rule: No such file
# or directory" (twice -- once per fib rule). netavark then rolls back, so
# `nft list ruleset` comes back EMPTY and every podman run fails at network
# setup. That is not a networking-only failure: it also takes down GATE2/3/4,
# because their capability probe has to start a container to run getcap, so
# a missing fib module reads as "all three container stores are broken".
# Observed exactly this way in CI cycle 2 on this branch.
# INET is the family netavark's table lives in; it needs both address-family
# backends present to resolve fib for inet.
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_FIB_INET=m
# iptables-compat matches the pre-flight survey listed as missing (container
# tooling's legacy iptables paths).
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m

# --- EROFS: makes the composefs/ostree image mode kernel-feasible (a later
# --- phase decides whether to adopt it).
CONFIG_EROFS_FS=m
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y

# --- dm-verity: verified-boot path for the later local-install phase.
# --- Parent CONFIG_BLK_DEV_DM is already =m on the board.
CONFIG_DM_VERITY=m

# --- podman container checkpoint/restore support.
CONFIG_CHECKPOINT_RESTORE=y
