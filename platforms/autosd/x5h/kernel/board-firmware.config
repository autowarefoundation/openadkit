# Board-image-only fragment, merged LAST by build-bsp-kernel.sh --firmware.
# rcar_gen5_mp_phy.bin is REQUIRED for the board to netboot at all:
# without it the built-in renesas,multi-protocol-phy driver fails probe
# (firmware ENOENT), renesas_eth_sw defers forever, there is no TSN link
# and no NFS root (2026-08-05 board session, Test A). The blob ships only
# in the NDA R-Car xOS SDK: it must never be committed, uploaded to CI,
# or referenced in the repo beyond this filename string (which the public
# linux-bsp driver source already carries). The two PCIe6 blobs stay
# excluded -- see the CONFIG_EXTRA_FIRMWARE block in autosd.config.
CONFIG_EXTRA_FIRMWARE="rcar_gen5_mp_phy.bin"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"
